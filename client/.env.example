# Copy this file to client/.env.local and fill in the values. .env.local is git-ignored.
# Restart "npm run dev" after changing it.

# Supabase project (Authentication): Project Settings → API Keys. Both values are public (sent to the browser);
# never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: URL of the FastAPI server. Default http://127.0.0.1:8000.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
