# Optional: copy this file to server/.env and fill in values. server/.env is git-ignored.
# Variables already set in your environment (e.g. a Windows user variable) work without this file.
# Restart the server after changing it.

# Sign-in (Supabase Auth): URL of the Supabase project (Project Settings → API Keys, without /rest/v1/). The server
# checks each request's access token with the project's public signing keys; no secret is needed. Without it every
# API request except /health is answered 503.
SUPABASE_URL=https://<project-ref>.supabase.co

# Database (PostgreSQL at Supabase), required: the server does not start without it. Supabase → Connect → Direct
# (Connection string) → method "Session pooler" (host *.pooler.supabase.com, port 5432; works over IPv4). Replace
# [YOUR-PASSWORD] with the database password (Project Settings → Database; URL-encode characters like @ # / : ?).
# Keep it secret: it gives full access to the database. Then, from server/: uv run alembic upgrade head
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secret key of the Supabase project (Project Settings → API Keys → Secret keys, "sb_secret_..."), required: the
# uploaded books and their covers are stored with it in the private Storage bucket "books". Keep it secret: it
# bypasses row-level security. It is only used by the server, never sent to the browser.
SUPABASE_SECRET_KEY=

# Optional: folder on the server's disk for books over Supabase Storage's 50 MB limit, when the user chooses "Store on
# server" while uploading (default server/data/books). Not backed up by Supabase.
# LOCAL_FILES_DIR=

# Email of the user who owns the existing library ("demo-campaign", the data from before sign-in existed) and is the
# app's admin (usage and costs of all users, MCP console). Every other user gets their own, empty library.
DEFAULT_CLIENT_OWNER=you@example.com

# Chat model and embeddings via OpenRouter — used when set.
OPENROUTER_API_KEY=

# Alternative: OpenAI directly — used only when OPENROUTER_API_KEY is empty.
OPENAI_API_KEY=

# Optional: Tavily search API key ("tvly-...", free plan at tavily.com). The Reddit scan (Market Intelligence →
# Discussions → Scan Reddit) finds threads with it, since Reddit blocks servers from its own JSON and API. Without it
# the scan answers 503; everything else works.
TAVILY_API_KEY=

# Optional: your own Facebook Page (Graph API): read its posts and comments, publish a post, reply to a comment —
# always on your click, never by itself. Without FACEBOOK_PAGE_ID and FACEBOOK_PAGE_TOKEN the Facebook features answer
# 503. Setup: developers.facebook.com → My Apps → Create app (development mode is enough for your own Page) → Use cases
# → "Manage everything on your Page" → add pages_show_list, pages_read_engagement, pages_read_user_content,
# pages_manage_posts, pages_manage_engagement. App settings → Basic gives the App ID and secret. Tools → Graph API
# Explorer → Generate Access Token (allow your Page) gives a user token that lasts about an hour; exchange it within
# that hour (GET /oauth/access_token?grant_type=fb_exchange_token, then GET /me/accounts) for the Page token, which
# does not expire. Keep the token and the secret secret. With FACEBOOK_APP_SECRET set every request carries an
# appsecret_proof. FACEBOOK_APP_ID and FACEBOOK_USER_TOKEN are only needed for that exchange.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_APP_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_USER_TOKEN=
# FACEBOOK_GRAPH_VERSION=v27.0

# Optional: your Telegram bot, where the agent sends proposed replies for your approval ("make it so"). Setup: in
# Telegram open @BotFather (the verified one, username exactly BotFather) → /newbot → a name and a username ending in
# "bot"; it gives the token. Then open your bot, press Start and send it a message; GET
# https://api.telegram.org/bot<token>/getUpdates shows your chat id (message.chat.id). The bot only listens to this
# chat. Keep the token secret: it controls the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The books (src_... ids of one client, comma-separated) the Page inbox agent answers your Facebook readers from; for
# each comment it picks the best fitting one.
FACEBOOK_INBOX_BOOKS=
# Minutes between the inbox's looks at your Page (default 30; 0 = only when you send /next to the bot). The inbox runs
# when TELEGRAM_*, FACEBOOK_PAGE_* and FACEBOOK_INBOX_BOOKS are set; run one server process only (one bot poll).
# FACEBOOK_INBOX_INTERVAL=30

# Optional: chat model. Default "openai/gpt-4o-mini" (OpenRouter) / "gpt-4o-mini" (OpenAI).
# LLM_MODEL=openai/gpt-4o-mini

# Optional: embedding model. Defaults: "openai/text-embedding-3-large" (OpenRouter),
# "text-embedding-3-large" (OpenAI). After changing it, press Re-index on every source.
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: timeouts and retries of model requests. A request that takes longer is retried; when every attempt
# fails the API answers 504 ("try again"). Defaults: 45 s per chat request, 30 s per embedding request, 3 retries.
# LLM_TIMEOUT_SECONDS=45
# EMBEDDING_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=3

# Optional: retrieval. MIN_RELEVANCE (0-1, default 0.3): passages less similar to the question are dropped; with
# none left, the answer is "not covered" without a model call. RETRIEVAL_MODE=dense (default) or hybrid (+ BM25).
# MIN_RELEVANCE=0.3
# RETRIEVAL_MODE=dense

# Optional: logging. LOG_FORMAT=json (default: one JSON object per line, each with the request id) or text
# (readable lines). LOG_LEVEL=INFO (default) or DEBUG (also logs every GET request, e.g. status polling).
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Debug mode, for developers only: true = every retrieval and generation run is traced in LangSmith
# (https://smith.langchain.com; needs LANGSMITH_API_KEY). Default false. Keep it false for customers and in
# production: with it on, prompts with book text, questions and generated texts are sent to LangSmith.
# LANGSMITH_TRACING is ignored; DEBUG_MODE alone decides. Restart the server after changing it.
# DEBUG_MODE=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=marketer-app
